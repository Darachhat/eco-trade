# =========================
# APPLICATION
# =========================

APP_NAME=ai_crypto_trader
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

APP_SECRET_KEY=change_me_to_a_random_secret_key_at_least_32_chars

# =========================
# BYBIT
# =========================

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

BYBIT_TESTNET=true
BYBIT_CATEGORY=linear

BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

# =========================
# TELEGRAM
# =========================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# =========================
# METATRADER 5 (EXNESS)
# =========================

MT5_LOGIN=463894594
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=Exness-MT5Trial17
# Set MT5_BRIDGE_URL to your Windows PC IP / Tunnel if running Docker on Linux
MT5_BRIDGE_URL=

# =========================
# DATABASE
# =========================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_trader
POSTGRES_USER=ai_trader_user
POSTGRES_PASSWORD=change_me_strong_password

DATABASE_URL=postgresql+asyncpg://ai_trader_user:change_me_strong_password@postgres:5432/ai_trader

# =========================
# REDIS
# =========================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

REDIS_URL=redis://redis:6379/0

# =========================
# CELERY
# =========================

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =========================
# ML
# =========================

ML_MODEL_PATH=/app/models
ML_ARTIFACT_PATH=/app/artifacts
MLFLOW_TRACKING_URI=http://mlflow:5000

# =========================
# PREDICTION
# =========================

PREDICTION_HORIZONS=5,10,20,50

MIN_CONFIDENCE=0.75
MIN_MODEL_AGREEMENT=0.70
MIN_RISK_REWARD=2.0

# =========================
# RISK
# =========================

RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=5

# =========================
# TRADING MODE
# =========================

# Options: backtest | paper | live
TRADING_MODE=paper

# Only used when TRADING_MODE=live — must be explicitly set to true
LIVE_EXECUTION_ENABLED=false

# =========================
# SELF LEARNING
# =========================

RETRAIN_ENABLED=true
RETRAIN_INTERVAL_HOURS=24

MIN_TRAINING_SAMPLES=10000

MODEL_PERFORMANCE_WINDOW=100

CHALLENGER_ENABLED=true

# =========================
# SIGNAL QUALITY
# =========================

MIN_SIGNAL_QUALITY_SCORE=65

# =========================
# MONITORING
# =========================

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
