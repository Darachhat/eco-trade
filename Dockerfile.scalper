# ==============================================================================
# Dockerfile.scalper
# ──────────────────
# Headless MetaTrader 5 scalper container (Wine + Xvfb on Ubuntu 24.04 noble)
# Runs run_scalper.py under Windows Python 3.9 inside Wine 24/7.
# ==============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    WINEPREFIX=/root/.wine \
    WINEDEBUG=-all \
    WINEARCH=win64

# ── Layer 1: Base system deps (cached unless this changes) ────────────────────
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \
        curl \
        ca-certificates \
        gnupg2 \
        software-properties-common \
        xvfb \
        x11-utils \
        xdotool \
        python3 \
        python3-pip \
        winbind && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 2: Official WineHQ stable repo for Ubuntu 24.04 (noble) ────────────
RUN mkdir -p /etc/apt/keyrings && \
    wget -qO /tmp/winehq.key https://dl.winehq.org/wine-builds/winehq.key && \
    gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key /tmp/winehq.key && \
    rm /tmp/winehq.key && \
    wget -qO /etc/apt/sources.list.d/winehq-noble.sources \
        "https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources" && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-stable && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /scalper

# ── Layer 3: Windows Python 3.9 inside Wine ───────────────────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & \
    sleep 3 && \
    wget -q -O /tmp/python-3.9.13-amd64.exe \
        https://www.python.org/ftp/python/3.9.13/python-3.9.13-amd64.exe && \
    wine /tmp/python-3.9.13-amd64.exe /quiet InstallAllUsers=1 PrependPath=1 \
        TargetDir="C:\\Python39" && \
    sleep 5 && \
    rm /tmp/python-3.9.13-amd64.exe

# ── Layer 4: MetaTrader5 Python package inside Wine Python ────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & \
    sleep 3 && \
    wine "C:\\Python39\\python.exe" -m pip install --upgrade pip && \
    wine "C:\\Python39\\python.exe" -m pip install MetaTrader5

# ── Layer 5: MT5 terminal inside Wine ─────────────────────────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & \
    sleep 3 && \
    wget -q -O /tmp/mt5setup.exe \
        https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe && \
    wine /tmp/mt5setup.exe /auto || true && \
    sleep 15 && \
    rm -f /tmp/mt5setup.exe

# ── Copy scalper + entrypoint ──────────────────────────────────────────────────
COPY run_scalper.py .
COPY docker-entrypoint-scalper.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
