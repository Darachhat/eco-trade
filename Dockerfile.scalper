# ==============================================================================
# Dockerfile.scalper — Wine + Xvfb + MT5 (Ubuntu 24.04 noble)
# ==============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    WINEPREFIX=/root/.wine \
    WINEDEBUG=-all \
    WINEARCH=win64

# ── Layer 1: Base system deps ─────────────────────────────────────────────────
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wget curl ca-certificates gnupg2 \
        xvfb x11-utils xdotool \
        python3 python3-pip winbind && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 2: WineHQ stable (official repo for Ubuntu 24.04 noble) ─────────────
RUN mkdir -p /etc/apt/keyrings && \
    wget -qO /tmp/winehq.key https://dl.winehq.org/wine-builds/winehq.key && \
    gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key /tmp/winehq.key && \
    rm /tmp/winehq.key && \
    wget -qO /etc/apt/sources.list.d/winehq-noble.sources \
        "https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources" && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-stable && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /scalper

# ── Layer 3: Initialize Wine prefix (MUST happen before any wine exe) ─────────
# wineboot --init creates the C:\ drive structure and registers kernel32.dll
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & \
    sleep 3 && \
    wineboot --init 2>/dev/null || true && \
    sleep 10 && \
    # Sanity check — kernel32.dll must exist
    test -f /root/.wine/drive_c/windows/system32/kernel32.dll && \
    echo "Wine prefix OK" || (echo "Wine prefix FAILED" && exit 1)

# ── Layer 4: Install Windows Python 3.9 inside Wine ──────────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & \
    sleep 3 && \
    wget -q -O /tmp/py39.exe \
        https://www.python.org/ftp/python/3.9.13/python-3.9.13-amd64.exe && \
    wine /tmp/py39.exe /quiet InstallAllUsers=1 PrependPath=1 \
        TargetDir="C:\\Python39" && \
    sleep 5 && \
    rm /tmp/py39.exe && \
    # Verify Python installed
    wine "C:\\Python39\\python.exe" --version

# ── Layer 5: MetaTrader5 pip package ─────────────────────────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & sleep 3 && \
    wine "C:\\Python39\\python.exe" -m pip install --upgrade pip && \
    wine "C:\\Python39\\python.exe" -m pip install MetaTrader5

# ── Layer 6: MT5 terminal ─────────────────────────────────────────────────────
RUN Xvfb :99 -screen 0 1024x768x16 -nolisten tcp & sleep 3 && \
    wget -q -O /tmp/mt5setup.exe \
        https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe && \
    wine /tmp/mt5setup.exe /auto || true && \
    sleep 15 && \
    rm -f /tmp/mt5setup.exe

# ── Copy files ────────────────────────────────────────────────────────────────
COPY run_scalper.py .
COPY docker-entrypoint-scalper.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
